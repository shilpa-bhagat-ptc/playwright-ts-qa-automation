# Port the extension listens on. Fly/Render/Cloud Run inject their own PORT.
PORT=3000

# GitHub App identifiers (from your registered Copilot Extension app).
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
# Private key in PEM form, either a path or the inline PEM (escape newlines as \n).
# Used only if you extend the handler to call GitHub APIs as the App itself.
GITHUB_APP_PRIVATE_KEY=

# Used by src/repl.js for local prompt iteration only — not by the server.
# Personal access token with the "copilot" scope (a regular PAT works for the
# Copilot LLM endpoint when used with your own Copilot subscription).
GITHUB_PAT=

# ─────────────────────────────────────────────────────────────────────────────
# The following are NOT used by the reference handler — they're listed so
# engineers extending this extension with skills (Jenkins trigger, PR push,
# email) have a single canonical set of var names that match the agent spec.
# ─────────────────────────────────────────────────────────────────────────────
JENKINS_URL=http://l10n-win2022-fsg1:8080/job/playwright-ts-qa-automation
JENKINS_USER=
JENKINS_TOKEN=
GITHUB_TOKEN=
GITHUB_REPO=
HECTOR_BASE_URL=https://hector.ptcnet.ptc.com/Hector
HECTOR_API_KEY=
HECTOR_PROJECT_PATH=
HECTOR_REPORT_JOB_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=sbhagat@ptc.com,pgadge@ptc.com
