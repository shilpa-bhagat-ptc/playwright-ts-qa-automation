# Environment variables for qa-link-jenkins-result-analyzer-auto-healing agent.
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit secrets.

# Jenkins (basic auth for fetching console + reports + triggering reporting job)
JENKINS_URL=http://l10n-win2022-fsg1:8080/job/playwright-ts-qa-automation
JENKINS_USER=qaadmin
JENKINS_TOKEN=__REPLACE_WITH_API_TOKEN__

# Hector reporting Jenkins job — the ONLY job this agent is permitted to trigger.
# It performs the build-level push to Hector. Per-test results are already
# uploaded by @ptc-fusion/playwright-hector-reporter during the test run.
HECTOR_REPORT_JOB_URL=http://l10n-win2022-fsg1:8080/job/Post-Hector-Results_QALink

# GitHub (push access for auto-heal branches + optional PR creation)
GITHUB_TOKEN=__REPLACE_WITH_GH_TOKEN__

# SMTP (failure-report email)
SMTP_HOST=smtp.ptcnet.ptc.com
SMTP_PORT=587
SMTP_USER=__REPLACE__
SMTP_PASS=__REPLACE__
SMTP_FROM=qa-link-agent@ptc.com
SMTP_TO=sbhagat@ptc.com,pagdge@ptc.com
